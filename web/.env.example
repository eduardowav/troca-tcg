# Configuração pública do Supabase para o frontend (Vite).
# Estas duas são chaves PÚBLICAS (vão no bundle do navegador) — seguras por design,
# desde que o RLS esteja ativo no banco (está). Nunca coloque aqui a service_role.
VITE_SUPABASE_URL=https://qbdtcpotehvbkozppmyu.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_fnmDKHi19WNJU3SrDp5WeQ_RsuTbo_W

# Base da API
VITE_API_URL=http://localhost:8000/v1

# Web Push: a chave pública VAPID, a mesma do `VAPID_PUBLIC_KEY` da API. É
# pública por desenho — o navegador a guarda para reconhecer quem pode mandar
# aviso para aquela inscrição. Vazia, o app não oferece o interruptor.
#
# Push exige origem segura: funciona em `localhost` e em https, nunca pelo IP da
# rede local em http. Para provar no celular, é produção (ou um túnel https).
VITE_VAPID_PUBLIC_KEY=BHQHBKdi7RzxVN3qd76b6AI-JyGxXA_7Uo4tIeLfVhl6GErvWfIe1hnTAL64FRA7iRkyQgl_cOYvr-ujJqt-MSw

# Monitoramento de erro (Sentry). Vazio em desenvolvimento de propósito: sem DSN
# o SDK nem é baixado (`lib/erros.ts` faz `import()` sob demanda), e o erro de
# quem está programando não polui o painel de produção — nem gasta a cota de
# 5 mil eventos por mês do plano free. Quem monta a tela quebrada continua vendo
# tudo no console.
VITE_SENTRY_DSN=
