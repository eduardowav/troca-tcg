# Banco (Supabase Postgres, driver async). Pegue a senha em
# Supabase > Project Settings > Database (se esquecer, só resetando).
# Projeto: troca-tcg (ref qbdtcpotehvbkozppmyu, região sa-east-1).
#
# Use o POOLER (Supavisor), não a conexão direta: no plano free o host direto
# `db.<ref>.supabase.co` só tem registro AAAA (IPv6), e de rede sem IPv6 a
# conexão morre com timeout — no Windows, o enigmático
# "[WinError 121] O tempo limite do semáforo expirou". O pooler tem IPv4.
#
# Porta 5432 = session mode: use esta. A 6543 (transaction mode) não suporta
# prepared statements, que o asyncpg usa por padrão.
# Repare que o usuário no pooler leva o ref junto: postgres.<ref>
DATABASE_URL=postgresql+asyncpg://postgres.qbdtcpotehvbkozppmyu:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Supabase. SERVICE_ROLE_KEY e JWT_SECRET ficam em Project Settings > API.
SUPABASE_URL=https://qbdtcpotehvbkozppmyu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=troque-me
SUPABASE_JWT_SECRET=troque-me

# Catálogo (TCGdex)
TCGDEX_BASE_URL=https://api.tcgdex.net/v2
TCGDEX_IDIOMA=pt

# E-mail transacional
RESEND_API_KEY=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Segurança
JOB_SECRET=troque-me
CORS_ORIGINS=http://localhost:5173,https://trocatcg.com.br

# Termos
TERMOS_VERSAO=2026-07-01

# Ambiente
ENVIRONMENT=development
