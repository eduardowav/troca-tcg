# Banco (Supabase Postgres, driver async). Pegue a senha em
# Supabase > Project Settings > Database (se esquecer, só resetando).
# Projeto: troca-tcg (ref qbdtcpotehvbkozppmyu, região sa-east-1).
#
# Use o POOLER (Supavisor), não a conexão direta: no plano free o host direto
# `db.<ref>.supabase.co` só tem registro AAAA (IPv6), e de rede sem IPv6 a
# conexão morre com timeout — no Windows, o enigmático
# "[WinError 121] O tempo limite do semáforo expirou". O pooler tem IPv4.
#
# Porta 5432 = session mode: use esta. A 6543 (transaction mode) não suporta
# prepared statements, que o asyncpg usa por padrão.
# Repare que o usuário no pooler leva o ref junto: postgres.<ref>
DATABASE_URL=postgresql+asyncpg://postgres.qbdtcpotehvbkozppmyu:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Supabase. SERVICE_ROLE_KEY e JWT_SECRET ficam em Project Settings > API.
SUPABASE_URL=https://qbdtcpotehvbkozppmyu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=troque-me
SUPABASE_JWT_SECRET=troque-me

# Catálogo (TCGdex)
TCGDEX_BASE_URL=https://api.tcgdex.net/v2
TCGDEX_IDIOMA=pt

# E-mail transacional
RESEND_API_KEY=

# Web Push (VAPID). Sem as duas chaves o push simplesmente não sai — o canal
# in-app continua inteiro, e é assim que o ambiente de desenvolvimento roda.
#
# A pública é a mesma que vai no `VITE_VAPID_PUBLIC_KEY` do web: é ela que o
# navegador guarda para reconhecer quem tem direito de mandar aviso. A privada
# nunca sai do servidor — trocar o par invalida todas as inscrições existentes,
# e cada pessoa precisaria ligar o aviso de novo.
#
# Gerar um par novo (P-256, em base64url):
#   python -c "import base64;from cryptography.hazmat.primitives.asymmetric import ec;from cryptography.hazmat.primitives import serialization as s;k=ec.generate_private_key(ec.SECP256R1());print('priv',base64.urlsafe_b64encode(k.private_numbers().private_value.to_bytes(32,'big')).decode().rstrip('='));print('pub',base64.urlsafe_b64encode(k.public_key().public_bytes(s.Encoding.X962,s.PublicFormat.UncompressedPoint)).decode().rstrip('='))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# O contato que o serviço de push procura antes de bloquear um remetente.
VAPID_SUBJECT=mailto:contato@trocatcg.com.br

# Segurança
JOB_SECRET=troque-me
CORS_ORIGINS=http://localhost:5173,https://trocatcg.com.br

# Termos. Precisa bater com a constante VERSAO em web/src/routes/Termos.tsx:
# é ela que vai para term_acceptances e prova qual texto a pessoa aceitou.
TERMOS_VERSAO=2026-07-28

# Ambiente
ENVIRONMENT=development
